{
  "manifest_version": 3,
  "name": "Pinehurst Dashboard",
  "version": "3.1",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://portals.veracross.au/pinehurst/*", "*://accounts.veracross.au/pinehurst/*", "*://classes.veracross.au/pinehurst/*", "*://documents.veracross.au/pinehurst/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": { "id": "pinehurst-dashboard@miltonwang", "strict_min_version": "128.0" }
  },
  "description": "Pinehurst Dashboard for the Student Portal: today's timetable, classes and news at a glance, every link in one Apps launcher.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pinehurst Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://portals.veracross.au/pinehurst/*"],
      "css": ["tokens.css", "styles.css"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://portals-embed.veracross.au/pinehurst/*"],
      "css": ["embed.css"],
      "js": ["early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://portals.veracross.au/pinehurst/*"],
      "js": ["banner.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://accounts.veracross.au/pinehurst/*"],
      "css": ["tokens.css", "login.css"],
      "js": ["login-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://portals-embed.veracross.au/pinehurst/*"],
      "js": ["embed.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://documents.veracross.au/pinehurst/schedule/*"],
      "css": ["tokens.css", "timetable.css"],
      "js": ["timetable.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://classes.veracross.au/pinehurst/*"],
      "css": ["tokens.css", "classes.css"],
      "js": ["classes-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://classes.veracross.au/pinehurst/*"],
      "js": ["classes.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "assets/clouds.jpg"],
      "matches": ["*://portals.veracross.au/*", "*://accounts.veracross.au/*", "*://portals-embed.veracross.au/*", "*://classes.veracross.au/*", "*://documents.veracross.au/*"]
    }
  ]
}
